{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmanuelalozie/gitops/schemas/policies.schema.json",
  "title": "Policies",
  "description": "config/policies.json: rules every resource must follow, checked with validation. A rule applies to the targets and kinds it names (all when it names none) and checks one field.",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "kinds": { "type": "array", "items": { "type": "string" } },
          "field": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "equals": {},
          "notEquals": {},
          "oneOf": { "type": "array", "minItems": 1 },
          "pattern": { "type": "string" },
          "message": { "type": "string", "description": "Why the rule exists, shown with every violation." }
        },
        "required": ["id", "field"],
        "anyOf": [
          { "required": ["required"] },
          { "required": ["equals"] },
          { "required": ["notEquals"] },
          { "required": ["oneOf"] },
          { "required": ["pattern"] }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["rules"],
  "additionalProperties": false
}
