{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmanuelalozie/gitops/schemas/repository.schema.json",
  "title": "Repository settings",
  "description": "The settings of one GitHub repository. One file, named after the repository, in config/<target>/repository/.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 350 },
    "homepage": { "type": "string" },
    "topics": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" },
      "maxItems": 20,
      "uniqueItems": true
    },
    "has_issues": { "type": "boolean" },
    "has_projects": { "type": "boolean" },
    "has_wiki": { "type": "boolean" },
    "allow_squash_merge": { "type": "boolean" },
    "allow_merge_commit": { "type": "boolean" },
    "allow_rebase_merge": { "type": "boolean" },
    "allow_auto_merge": { "type": "boolean" },
    "delete_branch_on_merge": { "type": "boolean" }
  },
  "required": ["name"],
  "additionalProperties": false
}
