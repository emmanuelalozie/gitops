{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands and a folder picker. No shell, no filesystem, no HTTP from the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-info",
    "allow-open-repo",
    "allow-close-repo",
    "allow-repo-status",
    "allow-engine-call",
    "allow-restart-engine",
    "allow-engine-info",
    "allow-token-status",
    "allow-set-token",
    "allow-clear-token",
    "allow-config-changes",
    "allow-working-diff",
    "allow-discard-change",
    "allow-file-history",
    "allow-commit-diff",
    "allow-propose",
    "allow-open-url",
    "allow-github-pulls",
    "allow-github-pull-details",
    "allow-github-drift",
    "allow-github-runs",
    "allow-github-dispatch",
    "allow-watch-settings",
    "allow-set-watch-settings",
    "allow-notify"
  ]
}
